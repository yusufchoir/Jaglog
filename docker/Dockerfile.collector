# Multi-stage Dockerfile for Collector & Worker
FROM node:22-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json* ./
RUN npm ci

FROM base AS runner
ENV NODE_ENV=production

RUN apk add --no-cache iputils && \
    addgroup --system --gid 1001 jagalog && \
    adduser --system --uid 1001 jagalog

COPY --from=deps /app/node_modules ./node_modules
COPY . .

USER jagalog

EXPOSE 5514/udp 5514/tcp 5515/tcp

CMD ["npx", "tsx", "collector/src/index.ts"]
