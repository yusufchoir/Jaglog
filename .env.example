# Database (PostgreSQL 16)
POSTGRES_USER=jagalog
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=jagalog
DATABASE_URL=postgres://jagalog:change_this_to_a_strong_password@localhost:5432/jagalog

# Cache, Session, Queue (Redis 7)
REDIS_PASSWORD=change_this_to_a_strong_password
REDIS_URL=redis://:change_this_to_a_strong_password@localhost:6379

# Application & Auth
SESSION_SECRET=change_this_to_at_least_32_characters_random_hex
ADMIN_USERNAME=admin
ADMIN_PASSWORD=JagaLogAdmin123!
TZ=Asia/Jakarta

# Syslog Collector Ports
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514

# AI Analyzer (anthropic | openai | ollama)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022

# Retention Policy
LOG_RETENTION_DAYS=30
